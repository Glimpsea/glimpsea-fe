{
  "manifest_version": 3,
  "name": "Glimpsea Research Demo",
  "version": "0.1.2",
  "description": "Read Etsy search results and review the evidence for your next product idea.",
  "icons": {
    "16": "icons/glimpsea-16.png",
    "32": "icons/glimpsea-32.png",
    "48": "icons/glimpsea-48.png",
    "128": "icons/glimpsea-128.png"
  },
  "permissions": ["sidePanel", "storage", "scripting"],
  "host_permissions": ["http://127.0.0.1/*"],
  "optional_host_permissions": ["https://www.etsy.com/*"],
  "content_scripts": [{
    "matches": ["http://127.0.0.1/demo-catalog*"],
    "js": ["catalog-content.js"],
    "css": ["catalog-content.css"]
  }],
  "side_panel": { "default_path": "panel.html" },
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Open Glimpsea",
    "default_icon": {
      "16": "icons/glimpsea-16.png",
      "32": "icons/glimpsea-32.png"
    }
  }
}
