# Local simulator. Copy this file to .env.local.
GLIMPSEA_RESEARCH_MODE=fixture

# To use NEAR AI Cloud, set the mode to near-ai-cloud and set the API key.
# GLIMPSEA_RESEARCH_MODE=near-ai-cloud
# NEAR_AI_API_KEY=
# NEAR_AI_MODEL=Qwen/Qwen3.6-35B-A3B-FP8

# Optional natural-language A2A demo. Enable Gemini only for the A2A seller.
# GLIMPSEA_A2A_RESEARCH_MODE=gemini
# GLIMPSEA_BUYER_GEMINI_API_KEY=
# GLIMPSEA_SELLER_GEMINI_API_KEY=
# GLIMPSEA_BUYER_GEMINI_MODEL=gemini-3.1-flash-lite
# GLIMPSEA_SELLER_GEMINI_MODEL=gemini-3.1-flash-lite
# GLIMPSEA_AGENT_ORIGIN=http://127.0.0.1:3000
# GLIMPSEA_BUYER_MAX_USDC=2.50
# GLIMPSEA_EXPECT_SELLER=gemini

# Optional A2A checkout on NEAR testnet.
# GLIMPSEA_A2A_NEAR_TESTNET=1
# GLIMPSEA_A2A_TESTNET_BUYER_ACCOUNT=buyer.testnet
# GLIMPSEA_A2A_TESTNET_SELLER_ACCOUNT=seller.testnet
# GLIMPSEA_A2A_TESTNET_BUYER_FILE=/absolute/path/to/buyer.testnet.json
# GLIMPSEA_A2A_TESTNET_MAX_NEAR=0.010001

# Optional self-hosted Agent Market listing and x402 buyer.
# GLIMPSEA_MARKET_AGENT_TOKEN=
# Shared by the worker and the report app. Use an absolute path if launched from different directories.
# GLIMPSEA_MARKET_DB_PATH=.data/market-worker.sqlite
# GLIMPSEA_REPORT_ORIGIN=http://127.0.0.1:3000
# GLIMPSEA_MARKET_AGENT_HANDLE=
# GLIMPSEA_MARKET_USDC_CONTRACT=
# GLIMPSEA_MARKET_TREASURY=
# GLIMPSEA_MARKET_BUYER_ACCOUNT=
# GLIMPSEA_MARKET_BUYER_KEY=

# Enable the extension checkout on NEAR testnet. Use a testnet receiver account.
# GLIMPSEA_EXTENSION_NEAR_TESTNET=1
# GLIMPSEA_NEAR_TESTNET_RECEIVER=
# GLIMPSEA_NEAR_TESTNET_RPC=https://rpc.testnet.fastnear.com
# GLIMPSEA_NEAR_CHECKOUT_CONTRACT=
# GLIMPSEA_NEAR_QUOTE_KEY_FILE=/run/glimpsea-quote/quote.pem

# Set this to the extension backend's public HTTPS origin when deploying on Dalang.
# GLIMPSEA_PUBLIC_ORIGIN=
# GLIMPSEA_DB_PATH=/data/glimpsea.sqlite

# Seller Agent chat in the NEAR testnet side panel. Uses the existing seller Gemini key.
# GLIMPSEA_EXTENSION_CHAT=1
# GLIMPSEA_EXTENSION_OWNER_ACCOUNT=operator.testnet
# Enable only when the Etsy authorization covers automated collection and AI use.
# GLIMPSEA_ETSY_AI_EVIDENCE=1
